# Copy this file to .env.local only when .env.local does not already exist.
# Set values locally. Never commit real API keys or use NEXT_PUBLIC_ for secrets.

# Default text generation/streaming and Gemini-based helper features.
GEMINI_API_KEY=

# Optional chapter providers. OpenAI illustration also uses Gemini for its prompt.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local SQLite storage does not make AI calls offline.
# Prompts, manuscript text and selected context may be sent to the AI provider.
